# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
# Plain `.env` as well as the `.env*.local` variants: the Expo/RN template ships
# only the latter, so a plain .env — the file most tooling actually reads — was
# not covered.
.env
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# local dev database
dev.db

# Pending image pool: manifest committed, the CC images are re-fetchable via scripts/devtest/fetch-bank.sh
eval/pool/*.jpg

# Exported diagnostics bundles
binocular-diagnostics-*.zip

# Coverage (written by jest --coverage, read by the Sonar scan in CI)
coverage/
